if SHIELD_KLOTZ_LEFT

config ZMK_KEYBOARD_NAME
    default "KLOTZ"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_KLOTZ_LEFT

if SHIELD_KLOTZ_LEFT || SHIELD_KLOTZ_RIGHT

config ZMK_SPLIT
    default y

endif # SHIELD_KLOTZ_LEFT/_RIGHT

if ZMK_BACKLIGHT

    config PWM
        default y

    config LED_PWM
        default y

endif # ZMK_BACKLIGHT
